@page "/front-desk"
@using TailorManager.Web.Api
@inject ICustomersClient Client
@inject IOrdersClient Orders

<h1>Customers</h1>

<form @onsubmit="Add">
    <input id="name" @bind="_newName" placeholder="Name" />
    <input id="phone" @bind="_newPhone" placeholder="Phone" />
    <input id="email" @bind="_newEmail" placeholder="Email" />
    <input id="address" @bind="_newAddress" placeholder="Address" />
    <button type="submit">Add</button>
</form>

<input id="search" @bind="_search" placeholder="Search by name, phone or email" />
<button id="search-button" @onclick="Search">Search</button>

<ul class="results">
    @foreach (var customer in _results)
    {
        <li>
            @customer.Name, @customer.Phone
            <button class="neworder" @onclick="() => ChooseCustomer(customer)">New order</button>
        </li>
    }
</ul>

@* The order form comes after the customer form, so "form" in the tests is still the customer form. *@
@if (_orderCustomer is not null)
{
    <h2>New order for @_orderCustomer.Name</h2>
    <form class="order" @onsubmit="CreateOrder">
        <select id="type" @bind="_newType">
            <option value="NewGarment">New garment</option>
            <option value="Repair">Repair</option>
        </select>
        <input id="workDescription" @bind="_newWorkDescription" placeholder="Work description" />
        <input id="agreedPrice" type="number" @bind="_newAgreedPrice" />
        <select id="relatedOrder" @bind="_newRelatedOrderId">
            <option value="">No earlier order</option>
            @foreach (var earlier in _customerOrders)
            {
                <option value="@earlier.Id">@earlier.WorkDescription (@earlier.Status)</option>
            }
        </select>
        <button type="submit">Create order</button>
    </form>
}

@code {
    // The customers to show. A new customer is added here; the search fills it in "Find customers".
    private readonly List<CustomerDto> _results = [];

    private string _newName = "";
    private string _newPhone = "";
    private string _newEmail = "";
    private string _newAddress = "";

    private async Task Add()
    {
        _results.Add(await Client.AddCustomerAsync(_newName, _newPhone, _newEmail, _newAddress));
        _newName = _newPhone = _newEmail = _newAddress = "";
    }

    private string _search = "";

    // The customer the new order is for, chosen with the button in the results.
    private CustomerDto? _orderCustomer;
    private string _newType = "NewGarment";
    private string _newWorkDescription = "";
    private decimal _newAgreedPrice;

    // The customer's earlier orders, so a repair or a reclamation can be linked to one of them.
    private List<OrderDto> _customerOrders = [];
    private string _newRelatedOrderId = "";

    private async Task ChooseCustomer(CustomerDto customer)
    {
        _orderCustomer = customer;
        _customerOrders = await Orders.ListOrdersAsync(customerId: customer.Id);
    }

    private async Task CreateOrder()
    {
        Guid? relatedOrderId = _newRelatedOrderId == "" ? null : Guid.Parse(_newRelatedOrderId);
        await Orders.CreateOrderAsync(_orderCustomer!.Id, _newType, _newWorkDescription, _newAgreedPrice, relatedOrderId);
        _orderCustomer = null;
        _newRelatedOrderId = "";
        _newType = "NewGarment";
        _newWorkDescription = "";
        _newAgreedPrice = 0;
    }

    private async Task Search()
    {
        _results.Clear();
        _results.AddRange(await Client.FindCustomersAsync(string.IsNullOrWhiteSpace(_search) ? null : _search));
    }
}
