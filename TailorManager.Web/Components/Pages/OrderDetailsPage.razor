@page "/orders/{Id:guid}"
@using System.Globalization
@using TailorManager.Web.Api
@inject IOrdersClient Client
@inject ICustomersClient Customers
@inject TokenStore Tokens

@if (_item is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@_item.WorkDescription</h1>

    <p class="status">Status: @_item.Status</p>
    <p class="customer">@_customer?.Name, @_customer?.Phone</p>

    <p class="current-price">Agreed price: @_item.CurrentAgreedPrice</p>

    <p class="outstanding-balance">
        Outstanding balance: @_item.OutstandingBalance
    </p>

    <h2>Customer decisions</h2>
    <ul class="decisionrequests">
        @foreach (var request in _item.CustomerDecisionRequests ?? [])
        {
            <li>
                @request.ProposedWorkChange (@request.ProposedPriceAdjustment), @request.Status
                @if (request.Status == "Pending" && Tokens.Role == Roles.Workshop)
                {
                    <button class="approve" @onclick="() => RecordCustomerDecision(request.Id, true)">Approve</button>
                    <button class="reject" @onclick="() => RecordCustomerDecision(request.Id, false)">Reject</button>
                }
            </li>
        }
    </ul>

    <h2>Fittings</h2>
    <ul class="fittings">
        @foreach (var fitting in _item.Fittings ?? [])
        {
            <li>
                @fitting.ScheduledAt.ToLocalTime().ToString("g") @fitting.Outcome
                @if (fitting.CompletedAt is null)
                {
                    @* Gets a Workshop check in "Only Workshop can complete fittings". *@
                    <input class="outcome" @bind="_newOutcome" placeholder="Outcome" />
                    <button class="completefitting" @onclick="() => CompleteFitting(fitting.Id)">Complete</button>
                }
            </li>
        }
    </ul>

    <h2>History</h2>
    <ul class="history">
        @foreach (var entry in (_item.History ?? []).OrderBy(h => h.OccurredAt))
        {
            <li>@entry.OccurredAt.ToLocalTime().ToString("g"), @entry.ActorDisplayName: @entry.Type @entry.Note</li>
        }
    </ul>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    @if (Tokens.Role == Roles.Workshop)
    {
        <button class="start" @onclick="StartWork">Start</button>

        <form class="note" @onsubmit="AddWorkNote">
            <input @bind="_newNote" />
            <button type="submit">Add</button>
        </form>

        <button class="readyforpickup" @onclick="MarkReadyForPickup">Ready for pickup</button>

        <form class="decisionrequest" @onsubmit="RequestCustomerDecision">
            <input class="workchange" @bind="_newWorkChange" placeholder="Proposed change" />
            <input class="priceadjustment" type="number" @bind="_newPriceAdjustment" placeholder="Price adjustment" />
            <button type="submit">Ask the customer</button>
        </form>

        <form class="fitting" @onsubmit="ScheduleFitting">
            <input class="scheduledat" type="datetime-local" value="@_newFittingAt" @onchange="@(e => _newFittingAt = e.Value?.ToString() ?? string.Empty)" />
            <button type="submit">Schedule fitting</button>
        </form>
    }

    @if (Tokens.Role == Roles.FrontDesk)
    {
        <form class="payment" @onsubmit="RegisterPayment">
            <input class="amount" @bind="_newAmount" />
            <input class="reference" @bind="_newReference" placeholder="Transaction reference" />
            <button type="submit">Register payment</button>
        </form>

        <button class="deliver" @onclick="MarkDelivered">Deliver</button>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OrderDto? _item;
    private CustomerDto? _customer;
    private string? _error;
    private string _newNote = "";
    private decimal _newAmount;
    private string _newReference = "";
    private string _newWorkChange = "";
    private decimal? _newPriceAdjustment;

    protected override async Task OnParametersSetAsync()
    {
        _item = await Client.GetOrderAsync(Id);
        _customer = await Customers.GetCustomerAsync(_item.CustomerId);
        _newAmount = _item.OutstandingBalance;
    }

    private Task StartWork() => Run(() => Client.StartWorkAsync(Id));

    private Task MarkReadyForPickup() => Run(() => Client.MarkReadyForPickupAsync(Id));

    private Task MarkDelivered() => Run(() => Client.MarkDeliveredAsync(Id));

    private async Task AddWorkNote()
    {
        if (await Run(() => Client.AddWorkNoteAsync(Id, _newNote)))
        {
            _newNote = "";
        }
    }

    private async Task RequestCustomerDecision()
    {
        if (await Run(() => Client.RequestCustomerDecisionAsync(Id, _newWorkChange, _newPriceAdjustment)))
        {
            _newWorkChange = "";
            _newPriceAdjustment = null;
        }
    }

    // The written answer is not on the page yet, so Guid.Empty stands in for it until "Record communication".
    private Task RecordCustomerDecision(Guid requestId, bool approved) =>
        Run(() => Client.RecordCustomerDecisionAsync(Id, requestId, Guid.Empty, approved));

    // The date and time from the datetime-local field, like "2026-11-26T10:00", in the browser's time zone.
    private string _newFittingAt = "";

    private async Task ScheduleFitting()
    {
        var scheduledAt = DateTimeOffset.Parse(_newFittingAt, CultureInfo.InvariantCulture);
        if (await Run(() => Client.ScheduleFittingAsync(Id, scheduledAt)))
        {
            _newFittingAt = "";
        }
    }

    private string _newOutcome = "";

    private async Task CompleteFitting(Guid fittingId)
    {
        if (await Run(() => Client.CompleteFittingAsync(Id, fittingId, _newOutcome)))
        {
            _newOutcome = "";
        }
    }

    private async Task RegisterPayment()
    {
        if (await Run(() => Client.RegisterPaymentAsync(Id, _newAmount, _newReference)))
        {
            _newAmount = _item!.OutstandingBalance;
            _newReference = "";
        }
    }

    // Every action on the order: send it, and read the order again so the page shows the new status.
    // When the API says no (like 409), the page shows its message instead.
    private async Task<bool> Run(Func<Task> action)
    {
        _error = null;
        try
        {
            await action();
            _item = await Client.GetOrderAsync(Id);
            return true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            return false;
        }
    }
}
