@page "/orders/{Id:guid}"
@using TailorManager.Web.Api
@inject IOrdersClient Client
@inject TokenStore Tokens

@if (_item is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@_item.WorkDescription</h1>

    <p class="outstanding-balance">
        Outstanding balance: @_item.OutstandingBalance
    </p>

    @if (Tokens.Role == Roles.Workshop)
    {
        <form class="note" @onsubmit="AddNote">
            <input @bind="_newNote" />
            <button type="submit">Add</button>
        </form>

        <button class="start" @onclick="Start">Start</button>

        <button class="readyforpickup" @onclick="MarkOrderReadyForPickup">
            Ready for pickup
        </button>
    }

    @if (Tokens.Role == Roles.FrontDesk)
    {
        <form class="payment" @onsubmit="AddPayment">
            <input @bind="_newAmount" />
            <button type="submit">Add</button>
        </form>

        <button class="deliver" @onclick="Deliver">Deliver</button>
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OrderDto? _item;
    private string? _error;

    private string _newNote = "";
    private decimal _newAmount;

    protected override async Task OnParametersSetAsync()
    {
        _item = await Client.GetOrderAsync(Id);
        _newAmount = _item.OutstandingBalance;
    }

    private async Task Start()
    {
        try
        {
            _error = null;
            await Client.StartOrderAsync(Id);
            _item = await Client.GetOrderAsync(Id);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AddNote()
    {
        await Client.AddWorkNoteAsync(Id, _newNote);
        _newNote = "";
        _item = await Client.GetOrderAsync(Id);
    }

    private async Task MarkOrderReadyForPickup()
    {
        await Client.MarkOrderReadyForPickupAsync(Id);
        _item = await Client.GetOrderAsync(Id);
    }

    private async Task AddPayment()
    {
        await Client.AddPaymentAsync(Id, _newAmount);
        _item = await Client.GetOrderAsync(Id);
        _newAmount = _item.OutstandingBalance;
    }

    private async Task Deliver()
    {
        await Client.DeliverOrderAsync(Id);
        _item = await Client.GetOrderAsync(Id);
    }
}
