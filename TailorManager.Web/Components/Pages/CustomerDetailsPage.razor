@page "/customers/{Id:guid}"
@rendermode InteractiveServer
@using TailorManager.Web.Api
@inject ICustomersClient Client

@if (_item is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@_item.Name</h1>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CustomerDto? _item;

    protected override async Task OnParametersSetAsync()
    {
        _item = await Client.GetCustomerAsync(Id);
    }
}
