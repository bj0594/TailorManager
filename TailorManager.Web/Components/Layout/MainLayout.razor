@inherits LayoutComponentBase
@inject TailorManager.Web.Api.TokenStore Tokens

<PageTitle>Tailor Manager</PageTitle>

<nav>
    <img src="icon.png" alt="" width="32" height="32" />
    @if (Tokens.Role == "FrontDesk")
    {
        <a href="front-desk">Search</a>
        <a href="front-desk/orders">Ready for pickup</a>
    }
    else if (Tokens.Role == "Workshop")
    {
        <a href="workshop/orders">Orders</a>
    }
</nav>

<main>@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
